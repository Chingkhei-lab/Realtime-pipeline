# Copy to .env and adjust as needed.
# NOTE: the containerised Postgres is published on host port 5433 because a native
# PostgreSQL Windows service already owns 5432. See README.md.
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5433/analytics

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RAW_TOPIC=events.raw
DLQ_TOPIC=events.dlq
